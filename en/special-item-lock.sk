# ============================================
# Special Item Lock
# Blocks crafting with, naming to and renaming of special items
# ============================================

# ============================================
# Banned keywords (add / edit them here)
# Matching is "name contains keyword" and ignores upper/lower case.
# ============================================
on script load:
    set {banned.keywords::*} to "Parkour", "Trophy", "Certificate", "Achievement", "Reward", "Commemorative", "Limited", "Event", "Legendary", "Epic", "Rare", "Artifact", "Exclusive", "Anniversary", "Christmas", "New Year", "Halloween", "Lunar New Year", "VIP", "Noble", "Admin", "Test", "Bound", "Untradeable", "Soul"

# ============================================
# Check function
# ============================================
function containsBannedKeyword(item: item) :: boolean:
    if name of {_item} is not set:
        return false
    loop {banned.keywords::*}:
        if name of {_item} contains loop-value:
            return true
    return false

# ============================================
# Block crafting with specially named items
# ============================================
on craft:
    loop all items in event-inventory:
        if containsBannedKeyword(loop-item) is true:
            cancel event
            send "&cYou can't craft with special items!" to player
            send action bar "&cYou can't craft with special items!" to player
            play sound "ENTITY_ENDERMAN_TELEPORT" with volume 0.5 with pitch 0.5 to player
            stop

# ============================================
# Anvil: block naming items with special names / putting special items in
# ============================================
on inventory click:
    if event-inventory is anvil inventory:
        # Block taking out an item that was named with a special name
        if index of event-slot is 2:
            if event-item is not air:
                if containsBannedKeyword(event-item) is true:
                    cancel event
                    send "&cYou can't name an item '%name of event-item%'!" to player
                    send action bar "&cYou can't name an item '%name of event-item%'!" to player
                    play sound "ENTITY_ENDERMAN_TELEPORT" with volume 0.5 with pitch 0.5 to player

        # Block putting special items into the anvil (normal click)
        if index of event-slot is 0:
            if cursor slot of player is not air:
                if containsBannedKeyword(cursor slot of player) is true:
                    cancel event
                    send "&cYou can't rename special items!" to player
                    send action bar "&cYou can't rename special items!" to player
                    play sound "ENTITY_ENDERMAN_TELEPORT" with volume 0.5 with pitch 0.5 to player

        # Block shift-clicking special items into the anvil
        if player is sneaking:
            if event-item is not air:
                if containsBannedKeyword(event-item) is true:
                    cancel event
                    send "&cYou can't rename special items!" to player
                    send action bar "&cYou can't rename special items!" to player
                    play sound "ENTITY_ENDERMAN_TELEPORT" with volume 0.5 with pitch 0.5 to player
